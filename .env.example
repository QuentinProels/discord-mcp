# Copy to .env and fill in. .env is gitignored and should be chmod 600 --
# the webhook URL is a credential: anyone holding it can post to your
# channel, and it is the only thing standing between your server and a
# stranger.

# Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Who discord_ask pings. Either "everyone" -- fine on a server where you
# are the only member -- or your numeric user id. A username does not work;
# Discord has no username form of a mention, and one here means no ping.
# For the id: Developer Mode on (User Settings -> Advanced), then
# right-click yourself -> Copy User ID.
DISCORD_MENTION=everyone

# Optional: the display name posts appear under.
DISCORD_MCP_USERNAME=Claude
